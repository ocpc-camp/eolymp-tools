# SMB print credentials for the daemon's queue.
#
# Copy this to  print_creds.env  (gitignored) and fill in the login + password,
# then run  ./apply_print_creds.sh  to (re)create the CUPS queue with them.
# To CHANGE the credentials later: edit print_creds.env and re-run that script.
#
# This is the one place to update the printer login/password.

PRINT_SMB_USER=
PRINT_SMB_PASSWORD=

# Optional (defaults shown) — usually leave commented:
#PRINT_QUEUE=ccstung1_auto                     # the CUPS queue the daemon prints to
#PRINT_SMB_SERVER=ccstung1.ad.cityu.edu.hk     # SMB print server
#PRINT_SMB_SHARE=csc_quota_queue               # share / queue name on that server
#PRINT_PPD_FROM=csc_quota_queue                # reuse this existing queue's PPD/driver
#PRINT_MEDIA=A4                                # paper size (CityUHK = A4)
