# Absolute path to gswin32.exe / gswin64.exe (Windows only). Leave empty
# to auto-detect the bundled copy in vendor/ghostscript/bin/, or to use
# `lp` (CUPS) on Linux/macOS.
# NOTE: if you set this manually, it MUST be an absolute path - gsprint
# runs Ghostscript from its own working directory.
GHOSTSCRIPT_PATH=
# Absolute path to gsprint.exe (Windows only). Leave empty to auto-detect
# the bundled copy in vendor/gsprint/. Must be absolute if set manually.
GSPRINT_PATH=

# Numeric ID of this physical printer. Should match the value of the
# `room` attribute of members whose jobs should be printed here.
# Use 1 if you are not using per-room routing.
PHYSICAL_PRINTER_ID=1

# Name of the local printer as the OS sees it (Windows: from "Devices and
# Printers"). Ignored on Linux/macOS, where the system default printer is
# used by `lp`.
PHYSICAL_PRINTER_NAME=

# Manual handoff mode: save each requested PDF for a volunteer instead of
# sending it to a physical printer. On macOS, the file is also opened in
# Preview and a notification with sound is displayed.
MANUAL_PRINT_MODE=false
MANUAL_PRINT_DIR=~/Desktop/OCPC Print Requests
MANUAL_PRINT_OPEN=true

# Auto-print (MANUAL_PRINT_MODE=false): after `lp`, wait this many seconds for
# the job to actually drain. If it holds for authentication or the printer is
# unreachable, the job is cancelled and it falls back to the manual handoff
# above — so nothing is lost even if the queue can't authenticate.
AUTO_CONFIRM_TIMEOUT=20
AUTO_CONFIRM_POLL=2

# Alert on every new print job, in both modes. On a secure-release printer the
# helper still has to release each batch at the device (ID card / Mobile ID QR),
# so the alert is how they get summoned.
# Desktop notification (macOS Notification Center / Linux notify-send):
DESKTOP_NOTIFY=true
# Attention sound: a macOS system sound name (see /System/Library/Sounds),
# repeated NOTIFY_SOUND_REPEAT times so it carries across the room.
# Empty NOTIFY_SOUND = silent.
NOTIFY_SOUND=Sosumi
NOTIFY_SOUND_REPEAT=3

# Eolymp access key (NOT a regular OAuth token — this client runs for hours).
# Required scopes: printer:printer:read printer:printer:write
#                  universe:space:read community:member:read
EOLYMP_TOKEN=CHANGE_ME

# Short name of the Eolymp space, e.g. "myevent2026".
EOLYMP_SPACE=CHANGE_ME

# ID of the (single) Eolymp printer for this space — the random string
# in the printer's URL in the admin console.
EOLYMP_PRINTER_ID=CHANGE_ME
